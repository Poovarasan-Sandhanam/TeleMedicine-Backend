# Copy to .env and fill in. .env is gitignored - never commit it.

# --- Server ---
SERVER_HOSTNAME=localhost
SERVER_PORT=3001
API_PREFIX=/api/v1
NODE_ENV=development

# --- Database ---
MONGO_URL=mongodb://127.0.0.1:27017/telemedicine
# Optional, only if your Mongo requires auth:
# MONGO_USERNAME=
# MONGO_PASSWORD=
# MONGO_DB_NAME=telemedicine

# --- Auth ---
# Signs every login token. Generate a fresh one, never reuse or share it:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or the Stripe dashboard in production.
# Without this the webhook refuses all requests by design.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- AWS S3 (profile image uploads) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
S3_BUCKET_NAME=

# --- OpenAI (symptom checker; optional - endpoint returns 503 without it) ---
OPENAI_API_KEY=
